# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
env/
ENV/
.venv/

# 打包 / 构建
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# 测试 / 覆盖率
.pytest_cache/
.coverage
htmlcov/

# 类型检查 / lint
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ==========================================
# Jupyter Notebook
# ==========================================
.ipynb_checkpoints/
*.nbconvert.ipynb

# ==========================================
# Deep Learning / ML
# ==========================================

# 模型权重文件
*.pth
*.pt
*.h5
*.ckpt
*.pkl
*.safetensors
*.onnx
*.bin

# 数据集（一般不提交）
data/
dataset/
datasets/

# 实验平台输出
runs/
wandb/
tensorboard/

# 临时文件
tmp/
temp/
*.tmp
*.log

# ==========================================
# 保留目录结构，但忽略目录内容
# 这些目录中请放一个 .gitkeep 文件
# ==========================================

# checkpoints/
checkpoints/*
!checkpoints/.gitkeep

# logs/
logs/*
!logs/.gitkeep

# outputs/
outputs/*
!outputs/.gitkeep

# results/（如果你后面也想保留这个目录，可以一起用）
results/*
!results/.gitkeep

# ==========================================
# Secrets / local config
# ==========================================
.env
secrets.json

# ==========================================
# IDE / Editor
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# OS
# ==========================================
.DS_Store
Thumbs.db